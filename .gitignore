# 依赖
node_modules/

# VitePress 构建输出
docs/.vitepress/dist/
docs/.vitepress/cache/

# 由 scripts/sync-content.mjs 生成的书架与作品首页（正文本身在 docs/novels/ 里，正常入库）
docs/index.md
docs/novels/*/index.md
docs/public/novels/

# Cloudflare wrangler 的本地缓存
.wrangler/

# 日志
*.log
npm-debug.log*
pnpm-debug.log*

# 系统文件
.DS_Store
Thumbs.db

# 编辑器
.vscode/
.idea/

# Crowbook 生成物（按需保留）
*.epub
*.pdf
# 但作品目录里的原始文件要入库（例如作为存档的原版 PDF）
!docs/novels/**/*.pdf
