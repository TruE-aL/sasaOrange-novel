# ============================================================
# 《机械飞升》crowbook 打包配置
# 用法：在本目录（正文/）下执行
#     crowbook config.book
# 只生成 epub 时可用
#     crowbook -t epub config.book
# ============================================================

# ---------- 书籍信息（EPUB 元数据，可自行修改）----------
title: 机械飞升
author: 你的名字
lang: zh
description: 机械飞升，这是一个人类实现永生的理想方案之一。
cover: cover.png

# ---------- 输出格式 ----------
output.epub: 机械飞升.epub
epub.version: 3

# ---------- 渲染设置 ----------
# 每个 .md 文件都作为一章，即使文件里没有 # 一级标题
crowbook.files_mean_chapters: true
# 在正文开头插入一个目录页
rendering.inline_toc: true
rendering.inline_toc.name: 目录

# ---------- 章节目录（顺序即正文顺序）----------
## 章节
+ 01-导语.md
+ 02-序章.md
+ 03-第一章.md
+ 04-第二章.md
+ 05-第三章.md
+ 06-第四章.md
+ 07-第五章.md
+ 08-第六章.md
+ 09-第七章.md
+ 10-第八章.md
+ 11-第九章.md
+ 12-第十章.md
+ 13-第十一章.md
+ 14-第十二章.md
+ 15-第十三章.md
+ 16-第十四章.md
+ 17-尾声.md
